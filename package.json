{
  "name": "mpv-rpc",
  "version": "2.5.0",
  "description": "Discord Rich Presence for MPV Media Player",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:all": "concurrently -n \"rpc,bridge\" -c \"cyan,magenta\" --handle-input --default-input-target 0 --kill-others \"node dist/index.js\" \"node stremio-mpv-bridge/server.js\"",
    "dev": "tsc && npm run start",
    "bridge": "npm run start --workspace=stremio-mpv-bridge",
    "build:userscript": "node stremio-mpv-bridge/scripts/build-userscript.mjs",
    "check:userscript": "node stremio-mpv-bridge/scripts/build-userscript.mjs --check",
    "test": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "format": "biome format .",
    "format:fix": "biome format --write",
    "release": "dotenv -e .env -v RELEASE_SCOPE=root -- semantic-release -e ./semantic-release/release.config.js -e ./semantic-release/release.config.js",
    "release:dry": "dotenv -e .env -v RELEASE_SCOPE=root -- semantic-release -e ./semantic-release/release.config.js -e ./semantic-release/release.config.js --dry-run",
    "release:bridge": "dotenv -e .env -v RELEASE_SCOPE=bridge -- semantic-release -e ./semantic-release/release.config.js -e ./semantic-release/release.config.js",
    "release:bridge:dry": "dotenv -e .env -v RELEASE_SCOPE=bridge -- semantic-release -e ./semantic-release/release.config.js -e ./semantic-release/release.config.js --dry-run"
  },
  "workspaces": [
    "stremio-mpv-bridge"
  ],
  "keywords": [
    "mpv",
    "discord",
    "rpc",
    "rich-presence"
  ],
  "license": "MIT",
  "dependencies": {
    "@xhayper/discord-rpc": "^1.2.0",
    "axios": "^1.16.0",
    "discord-api-types": "^0.38.47",
    "dotenv": "^17.2.3",
    "socks-proxy-agent": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
