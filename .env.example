# Discord Application Client ID
DISCORD_CLIENT_ID=1450169544701378570

# MPV executable path (optional - searches in default directories if not set)
# Windows example: C:\Program Files\mpv\mpv.exe
# Linux example: /usr/bin/mpv
MPV_PATH=

# Settings
# Show anime cover as large image
SHOW_COVER=true
# Hide all media details
PRIVACY_MODE=false
# Hide status when MPV is idling
HIDE_IDLING=false
# Use anime title as activity name instead of "MPV"
SHOW_TITLE=true
# Preferred language for the anime title: "eng", "romaji" or "none" (use filename),
TITLE_LANG=none
# Metadata provider: jikan (MAL), anilist, kitsu or tvdb
METADATA_PROVIDER=jikan
# Enable Discord Rich Presence
DISCORD_RPC=true
# Enable detailed provider/API error logs in .anime_cache/api_log.txt and .anime_cache/stremio_*.txt
DEBUG=false

# Update loop interval in milliseconds (how often to poll MPV, default: 1000)
UPDATE_INTERVAL=1000

# ----- MPV IPC -----
# Named pipe path for MPV IPC (used by both mpv-rpc and the Stremio bridge)
# Windows: \\.\pipe\mpv
# Unix: /tmp/mpv-socket
MPV_IPC_PATH=

# ----- TheTVDB -----
# TVDB API key (get one at https://thetvdb.com/api-information)
# Required when using tvdb as metadata provider; also used by Trakt sync
# to map aired/default -> absolute episode numbers for anime.
#
# Without TVDB_API_KEY, nothing breaks — the system gracefully degrades:
#   - TVDB is not added to the fallback provider chain
#   - Trakt scrobbling for anime with non-standard episode numbering
#     (absolute order) falls back to less accurate resolution methods
#   - All other features (Discord RPC, MAL sync, metadata resolution)
#     work normally using Jikan/AniList/Kitsu providers
TVDB_API_KEY=
# Language for TVDB data (episode titles, descriptions)
# Aliases: en, pt, ja, es, fr, de, it, ru, zh, cn, ko, kr
# ISO 639 codes also work: eng, por, jpn, spa, fra, deu, ita, rus, zho, kor
# See: https://en.wikipedia.org/wiki/List_of_ISO_639_language_codes
TVDB_LANG=eng

# ----- TMDb -----
# Metadata for movies and non-anime series (poster, official title, year, episode names).
# Create a free key at https://www.themoviedb.org/settings/api. Both the v3 API key and the
# v4 "API Read Access Token" (starts with eyJ) work.
# Without TMDB_API_KEY the app keeps working, only without movie and series metadata.
TMDB_API_KEY=
# Language for the main TMDb poster, titles and episode names (en-US, pt-BR, ja-JP).
# Also accepts pt/por -> pt-BR, en/eng -> en-US, ja/jpn -> ja-JP.
# Requests are always logged in .anime_cache/api_log.txt, even with DEBUG=false.
TMDB_LANG=en-US

# ----- MAL Sync -----
# Enable MAL sync (mark episodes as watched)
MAL_SYNC=false
# Your MAL API Client ID (get one at https://myanimelist.net/apiconfig)
MAL_CLIENT_ID=
# Percentage watched to trigger sync (default: 90)
MAL_SYNC_THRESHOLD=90
# OAuth tokens are stored in .config/.mal_tokens.json after running `npm start -- mal-auth`

# ----- Trakt Sync -----
# Enable Trakt.tv scrobbling (mark episodes as watched on Trakt)
TRAKT_SYNC=false
# Trakt API Client ID (create app at https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=
# Trakt API Client Secret (create app at https://trakt.tv/oauth/applications)
TRAKT_CLIENT_SECRET=
# Percentage watched to trigger scrobble (default: 81)
TRAKT_SYNC_THRESHOLD=81
# Use Tor network to bypass Cloudflare blocks (requires Tor installed and running)
TRAKT_USE_TOR=false
# Tor SOCKS5 proxy URL (default: Tor Browser default)
TRAKT_TOR_PROXY=socks5://127.0.0.1:9050
# OAuth tokens are stored in .config/.trakt_tokens.json after running `npm start -- trakt-auth`

# ----- Stremio Sync -----
# Enable conservative Stremio Continue Watching progress sync
STREMIO_SYNC=false
# Percentage watched to mark items as watched in Stremio (default: 85)
STREMIO_SYNC_THRESHOLD=85
# Minimum interval between Continue Watching writes while playback is active (default: 90000, min: 30000)
# Stremio Core enforces a 90-second rate limit for library updates
STREMIO_PROGRESS_INTERVAL_MS=90000
# Auth token is captured by the Stremio bridge and stored in .config/.stremio_tokens.json

# ----- Auto-Fetch -----
# RPC-side Auto-Fetch feature gate (default: true).
# In normal use, disable Auto-Fetch from the bridge UI/config.
# Set AUTO_FETCH=false as the global kill switch.
AUTO_FETCH=true

# ----- Sync Dry-Run -----
# When true, ALL external sync operations (Trakt scrobbles, Stremio writes,
# Auto-Fetch POSTs) are logged but not executed. Useful for testing the
# pipeline without polluting the user's accounts.
# Default: false
SYNC_DRY_RUN=false
